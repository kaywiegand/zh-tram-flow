      "nav_label": "Ausgangssituation",
      "slides": [
        {
          "title": "Ausgangssituation",
          "subtitle": "OTP 87 % netzweit, Ziel 95 % bis 2028 — Analyse vor Modellierung",
          "content": [
            {
              "type": "figures",
              "items": [
                { "value": "87 %",   "label": "OTP netzweit 2023–2025",       "sentiment": "negative" },
                { "value": "−8 PP",   "label": "Lücke zum VBZ-Ziel 95 %",       "sentiment": "negative" },
                { "value": "56,3 s",   "label": "Ø Ankunftsverspätung",          "sentiment": "warning" },
                { "value": "71,5 %",   "label": "Halte akkumulieren Delay",      "sentiment": "warning" }
              ]
            },
            {
              "type": "steps",
              "items": [
                {
                  "step": "1",
                  "label": "Analyse der Entstehungsmuster und Einflussfaktoren",
                  "detail": "Temporal · Räumlich · Netzwerk · Meteorologie · Events · Zieldefinition"
                },
                {
                  "step": "2",
                  "label": "Verspätungen vorhersagen",
                  "detail": "arrival_delay in Sekunden — direkt kommunizierbar, kein Schwellwert-Bias. Temporaler Split, kein Shuffle"
                }
              ]
            }
          ]
        }
      ]
    },

    {
      "nav_label": "Datenstrategie",
      "slides": [
        {
          "title": "Datenstrategie",
          "subtitle": "Vier Quellen, ein temporaler Join, 94,4 Millionen Zeilen",
          "content": [
            {
              "type": "sections",
              "items": [
                {
                  "label": "VBZ IST-Daten (Primärquelle)",
                  "points": [
                    "Reale Ankunfts- und Abfahrtszeiten aller Tramhalte 2023–2025",
                    "Granularität: Fahrt × Haltestelle × Timestamp",
                    "Enthält canceled = True Fahrten — bewusst behalten (relevante Extremfälle)"
                  ]
                },
                {
                  "label": "GTFS (Fahrplandaten)",
                  "points": [
                    "Geplante Ankunfts-/Abfahrtszeiten, dwell_time, stop_sequence",
                    "Liniengeometrien und Haltestellen-Koordinaten (lat/lon)",
                    "Join-Key: trip_id × stop_id × service_date"
                  ]
                },
                {
                  "label": "Meteo Schweiz",
                  "points": [
                    "Stündliche Messwerte: Temperatur, Niederschlag, Windgeschwindigkeit",
                    "Join über Zeitstempel (hour-level) auf IST-Daten",
                    "Abgeleitete Flags: has_rain, has_snow, has_heavy_rain, is_hot"
                  ]
                },
                {
                  "label": "Event-Kalender",
                  "points": [
                    "Grossveranstaltungen Zürich 2023–2025: Konzerte, Messen, Sport",
                    "Kategorisierung: event_type, event_size, event_weight",
                    "Ergebnis: 94,4 Mio. Zeilen · 26 Features · 541 MB Parquet"
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Datenstrategie",
          "subtitle": "Cleaning-Entscheidungen und ihre Begründungen",
          "content": [
            {
              "type": "contrasts",
              "items": [
                {
                  "assumption": "Canceled-Fahrten entfernen",
                  "finding": "Behalten: canceled = True Zeilen sind relevante Extremfälle — Modell soll auch Ausfälle antizipieren können"
                },
                {
                  "assumption": "Shuffle-Split für mehr Trainingsdaten",
                  "finding": "Temporal Split: Zukunft darf Vergangenheit nicht kennen. Shuffle würde Data Leakage erzeugen"
                },
                {
                  "assumption": "arrival_delay winsorisieren (Extremwerte kappen)",
                  "finding": "Kein Capping: MAE belohnt Präzision auch bei Extremwerten. Winsorisierung würde Systemfehler verbergen"
                },
                {
                  "assumption": "Alle Haltestellen gleich behandeln",
                  "finding": "stop_sequence_pct als normierter Streckenfortschritt — erlaubt linienübergreifendes Lernen ohne One-Hot-Explosion"
                }
              ]
            }
          ]
        }
      ]
    },

    {
      "nav_label": "Baseline",
      "slides": [
        {
          "title": "Baseline",
          "subtitle": "Stop Mean als sinnvollster naiver Benchmark",
          "content": [
            {
              "type": "comparison_table",
              "columns": ["Ansatz", "Logik", "MAE (Test)"],
              "rows": [
                { "cells": ["Grand Mean",  "Immer Netz-Ø vorhersagen (56,3 s)",    "50,6 s"], "highlight": false },
                { "cells": ["Hour Mean",   "Ø nach Tagesstunde",                   "50,5 s"], "highlight": false },
                { "cells": ["Line Mean",   "Ø nach Linie",                         "50,4 s"], "highlight": false },
                { "cells": ["Stop Mean",   "Ø nach Haltestelle (stärkste naive Baseline)", "50,0 s"], "highlight": true }
              ]
            },
            {
              "type": "statement",
              "text": "Stop Mean gewinnt, weil Haltestellen strukturell unterschiedliche Delay-Level haben. Jedes Modell muss diesen Benchmark schlagen. Grand Mean, Hour Mean und Line Mean liegen alle < 1s voneinander entfernt — reine Mittelwert-Strategien bringen keinen Vorteil.",
              "sentiment": "neutral"
            }
          ]
        }
      ]
    },

    {
      "nav_label": "Feature Engineering",
      "slides": [
        {
          "title": "Feature Engineering",
          "subtitle": "34 Features v1, 36 Features v2 — der entscheidende Unterschied",
          "content": [
            {
              "type": "sections",
              "items": [
                {
                  "label": "Temporale Features (v1)",
                  "points": [
                    "hour, weekday, month, season, year",
                    "is_weekend, is_november, is_holiday",
                    "is_late_night_weekend (Kombinations-Feature)"
                  ]
                },
                {
                  "label": "Netz-Features (v1)",
                  "points": [
                    "line_name, stop_name (native categoricals — kein One-Hot)",
                    "district_nr, n_lines_at_stop, n_stops_line",
                    "is_start_stop, is_end_stop, dwell_time"
                  ]
                },
                {
                  "label": "Externe Features (v1)",
                  "points": [
                    "temperature, precipitation, wind_speed",
                    "has_rain, has_heavy_rain, has_snow, has_flood, is_hot",
                    "has_event, event_type, event_size, event_weight, event_weight_x_hour"
                  ]
                },
                {
                  "label": "Kaskaden-Features (neu in v2)",
                  "points": [
                    "prev_trip_delay: Verspätung des Vorgänger-Trips an diesem Halt — echtzeit-verfügbar",
                    "stop_sequence_pct: normierter Streckenfortschritt (0–1) — linienübergreifend lernbar",
                    "Ergebnis: MAE 45,7 s → 18,56 s, −63 %"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },

    {
      "nav_label": "Modellauswahl",
      "slides": [
        {
          "title": "Modellauswahl und -Anpassung",
          "subtitle": "Warum LightGBM, warum kein Hyperparameter-Tuning",
          "content": [
            {
              "type": "contrasts",
              "items": [
                {
                  "assumption": "XGBoost als Standard-Benchmark",
                  "finding": "XGBoost: val MAE ~21,4 s bei 150 Runden auf 85M Zeilen — über 90 Minuten Trainingszeit. LightGBM: vergleichbare Qualität in ca. 18 Minuten. Klare Wahl für iteratives Arbeiten."
                },
                {
                  "assumption": "Native Categoricals über One-Hot Encoding",
                  "finding": "LightGBM verarbeitet Kategorien nativ — kein One-Hot für line_name, stop_name, event_type. Weniger Speicher, schnelleres Training, keine künstliche Sparsität."
                },
                {
                  "assumption": "Hyperparameter-Tuning vor Feature Engineering",
                  "finding": "Bewusste Entscheidung dagegen: Feature Engineering bringt mehr als Tuning auf schwachen Features. prev_trip_delay allein liefert −27s MAE. Tuning käme danach."
                },
                {
                  "assumption": "Early Stopping als Tuning-Ersatz",
                  "finding": "Early Stopping mit Validation-Set steuert Modellkomplexität automatisch. Verhindert Overfitting ohne manuelle Suche nach n_estimators."
                }
              ]
            }
          ]
        },
        {
          "title": "Modellauswahl und -Anpassung",
          "subtitle": "v1 zu v2: der Sprung kam aus der Analyse, nicht aus dem Algorithmus",
          "content": [
            {
              "type": "comparison_table",
              "columns": ["Version", "Neue Features", "MAE (Test)", "MBE (Test)", "OTP-Verbesserung"],
              "rows": [
                { "cells": ["Baseline (Stop Mean)", "—",                                        "50,0 s", "—",      "—"],        "highlight": false },
                { "cells": ["LightGBM v1",          "34 Features (Zeit · Wetter · Netz)",       "45,7 s", "+8,3 s",  "71,9 % → 77,5 %"], "highlight": false },
                { "cells": ["LightGBM v2",          "+prev_trip_delay, +stop_sequence_pct",     "18,56 s", "−0,69 s", "→ kalibriert"], "highlight": true }
              ]
            },
            {
              "type": "statement",
              "text": "v1 war systematisch zu optimistisch (MBE +8,3 s). v2 mit Isotonic-Regression-Kalibrierung: MBE −0,69 s. Der MAE-Sprung von 45,7 s auf 18,56 s entspricht −63 % und erklärt sich vollständig durch prev_trip_delay — das stärkste neue Feature.",
              "sentiment": "positive"
            }
          ]
        },
        {
          "title": "Robustheits-Check",
          "subtitle": "XGBoost-Vergleich und Stabilitätsprüfung",
          "content": [
            {
              "type": "figures",
              "items": [
                { "value": "~21,4 s", "label": "XGBoost val MAE (150 Runden)", "sentiment": "warning" },
                { "value": "90+ Min", "label": "XGBoost Trainingszeit auf 85M Zeilen", "sentiment": "negative" },
                { "value": "18 Min",  "label": "LightGBM v2 Trainingszeit", "sentiment": "positive" },
                { "value": "18,56 s",  "label": "LightGBM v2 Test MAE (2025)", "sentiment": "positive" }
              ]
            },
            {
              "type": "statement",
              "text": "XGBoost erreicht auf dem Validation-Set vergleichbare Qualität, braucht aber 5× mehr Zeit. Für iteratives Feature Engineering über mehrere Wochen ist LightGBM die klar überlegene Wahl. Das ist eine Workflow-Entscheidung, keine Qualitätskompromittierung.",
              "sentiment": "neutral"
            }
          ]
        }
      ]
    },

    {
      "nav_label": "Evaluation",
      "slides": [
        {
          "title": "Feature Importance",
          "subtitle": "prev_trip_delay dominiert — die Analyse hat recht behalten",
          "content": [
            {
              "type": "chart_refs",
              "items": [
                {
                  "label": "Feature Importance LightGBM v2",
                  "source": "model-feature-importance",
                  "caption": "Feature Importance (Gain). prev_trip_delay und stop_sequence_pct dominieren. Temporale und Wetter-Features zeigen konsistente, aber deutlich schwächere Beiträge."
                }
              ]
            },
            {
              "type": "statement",
              "text": "Die Kaskadenanalyse (r ≥ 0,85 netzweit) hat die Feature-Wichtigkeit korrekt antizipiert. Das Modell bestätigt: Das Signal steckt in den Daten, nicht im Algorithmus.",
              "sentiment": "positive"
            }
          ]
        },
        {
          "title": "Produktionsreife und Reflexion",
          "subtitle": "Was produktionsreif ist, was offen bleibt",
          "content": [
            {
              "type": "contrasts",
              "items": [
                {
                  "assumption": "Produktionsreif",
                  "finding": "LightGBM v2: MAE 18,56 s, MBE −0,69 s, trainiert auf 41M Fahrten, getestet auf vollständigem Jahr 2025 (~29M). Streamlit-Dashboard mit Live-Predictor lauffähig. Code vollständig reproduzierbar."
                },
                {
                  "assumption": "Offen: Hyperparameter-Tuning",
                  "finding": "Wurde bewusst zurückgestellt. Nächster Schritt nach Feature Engineering. Potenziell weitere −2 bis −4s MAE erreichbar."
                },
                {
                  "assumption": "Offen: v2 im Streamlit-Predictor",
                  "finding": "Dashboard nutzt aktuell v1 (Pre-Trip-Use-Case ohne prev_trip_delay). v2 erfordert Live-Signal aus VBZ-Betriebssystem — setzt Daten-Integration voraus."
                },
                {
                  "assumption": "Offen: Ensemble / Stacking",
                  "finding": "Nicht evaluiert. LightGBM v2 allein liefert bereits −63 % vs. Baseline. Ensemble-Ansätze wären nächste Iteration."
                }
              ]
            }
          ]
        }
      ]
    },

