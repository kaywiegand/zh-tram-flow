                },
                {
                  "step": "2",
                  "label": "Verspätungen vorhersagen",
                  "detail": "Folgen sie Mustern, die ein Modell lernen kann? — LightGBM, MAE 18,56 s (arrival_delay in Sekunden), −63 % vs. Baseline"
                }
              ]
            }
          ]
        }
      ]
