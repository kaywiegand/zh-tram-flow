    {
      "nav_label": "Datenstrategie",
      "slides": [
        {
          "title": "Datenstrategie",
          "subtitle": "Vier Quellen, ein temporaler Join, 94,4 Millionen Zeilen",
          "content": [
            {
              "type": "sections",
              "items": [
                {
                  "label": "VBZ IST-Daten (Primärquelle)",
                  "points": [
                    "Reale Ankunfts- und Abfahrtszeiten aller Tramhalte 2023–2025",
                    "Granularität: Fahrt × Haltestelle × Timestamp",
                    "Enthält canceled = True Fahrten — bewusst behalten (relevante Extremfälle)"
                  ]
                },
                {
                  "label": "GTFS (Fahrplandaten)",
                  "points": [
                    "Geplante Ankunfts-/Abfahrtszeiten, dwell_time, stop_sequence",
                    "Liniengeometrien und Haltestellen-Koordinaten (lat/lon)",
                    "Join-Key: trip_id × stop_id × service_date"
                  ]
                },
                {
                  "label": "Meteo Schweiz",
                  "points": [
                    "Stündliche Messwerte: Temperatur, Niederschlag, Windgeschwindigkeit",
                    "Join über Zeitstempel (hour-level) auf IST-Daten",
                    "Abgeleitete Flags: has_rain, has_snow, has_heavy_rain, is_hot"
                  ]
                },
                {
                  "label": "Event-Kalender",
                  "points": [
                    "Grossveranstaltungen Zürich 2023–2025: Konzerte, Messen, Sport",
                    "Kategorisierung: event_type, event_size, event_weight",
                    "Ergebnis: 94,4 Mio. Zeilen · 26 Features · 541 MB Parquet"
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Datenstrategie",
          "subtitle": "Cleaning-Entscheidungen und ihre Begründungen",
          "content": [
            {
              "type": "contrasts",
              "items": [
                {
                  "assumption": "Canceled-Fahrten entfernen",
                  "finding": "Behalten: canceled = True Zeilen sind relevante Extremfälle — Modell soll auch Ausfälle antizipieren können"
                },
                {
                  "assumption": "Shuffle-Split für mehr Trainingsdaten",
                  "finding": "Temporal Split: Zukunft darf Vergangenheit nicht kennen. Shuffle würde Data Leakage erzeugen"
                },
                {
                  "assumption": "arrival_delay winsorisieren (Extremwerte kappen)",
                  "finding": "Kein Capping: MAE belohnt Präzision auch bei Extremwerten. Winsorisierung würde Systemfehler verbergen"
                },
                {
                  "assumption": "Alle Haltestellen gleich behandeln",
                  "finding": "stop_sequence_pct als normierter Streckenfortschritt — erlaubt linienübergreifendes Lernen ohne One-Hot-Explosion"
                }
              ]
            }
          ]
        }
      ]
    },
