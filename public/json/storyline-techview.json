    {
      "nav_label": "Modellauswahl",
      "slides": [
        {
          "title": "Modellauswahl und -Anpassung",
          "subtitle": "Warum LightGBM, warum kein Hyperparameter-Tuning",
          "content": [
            {
              "type": "contrasts",
              "items": [
                {
                  "assumption": "XGBoost als Standard-Benchmark",
                  "finding": "XGBoost: val MAE ~21,4 s bei 150 Runden auf 85M Zeilen — über 90 Minuten Trainingszeit. LightGBM: vergleichbare Qualität in ca. 18 Minuten. Klare Wahl für iteratives Arbeiten."
                },
                {
                  "assumption": "Native Categoricals über One-Hot Encoding",
                  "finding": "LightGBM verarbeitet Kategorien nativ — kein One-Hot für line_name, stop_name, event_type. Weniger Speicher, schnelleres Training, keine künstliche Sparsität."
                },
                {
                  "assumption": "Hyperparameter-Tuning vor Feature Engineering",
                  "finding": "Bewusste Entscheidung dagegen: Feature Engineering bringt mehr als Tuning auf schwachen Features. prev_trip_delay allein liefert −27s MAE. Tuning käme danach."
                },
                {
                  "assumption": "Early Stopping als Tuning-Ersatz",
                  "finding": "Early Stopping mit Validation-Set steuert Modellkomplexität automatisch. Verhindert Overfitting ohne manuelle Suche nach n_estimators."
                }
              ]
            }
          ]
        },
        {
          "title": "Modellauswahl und -Anpassung",
          "subtitle": "v1 zu v2: der Sprung kam aus der Analyse, nicht aus dem Algorithmus",
          "content": [
            {
              "type": "comparison_table",
              "columns": [
                "Version",
                "Neue Features",
                "MAE (Test)",
                "MBE (Test)",
                "OTP-Verbesserung"
