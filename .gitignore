# .gitignore – Python / Data Science (uv + venv)
# ------------------------------------------------
# WICHTIG: Daten und Modelle NICHT in Git einchecken!
# uv.lock wird NICHT ignoriert – Lockfile gehört in Git!

# ── Persönliche Notizen ────────────────────────────────────────────────────
NOTES.md

# ── Daten ──────────────────────────────────────────────────────────────────
data/raw/
data/interim/
data/processed/
*.csv
*.xlsx
*.parquet
# Ausnahme: Dashboard-Aggregationen sind kleine pre-computed Tabellen (~100KB)
!apps/dashboard/data/*.parquet
*.feather
*.h5
*.hdf5

# ── Modelle & Artefakte ────────────────────────────────────────────────────
models/
*.pkl
*.joblib
*.pt
*.pth

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/
*.so

# ── Virtuelle Umgebung (uv erstellt .venv/) ────────────────────────────────
.venv/
.env
*.env

# ── Jupyter ────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_metadata

# ── Portfolio Pipeline (Migration) ────────────────────────────────────────
# Backup directories created during portfolio pipeline setup (2026-06-19)
# Used for validation, not part of final artifacts
public/json-backup/
public/html-backup/
# Versioned snapshots before each regeneration run (lokale Historie, kein Artefakt)
public/archive/

# ── IDE & OS ───────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# ── Reports (optional – kommentiere aus, wenn du Reports tracken willst) ───
# reports/figures/
# reports/tables/
.claude/worktrees/

# NotebookLM exports — never in git
public/notebooklm/
